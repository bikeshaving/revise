{
  "name": "@b9g/revise",
  "version": "0.1.6",
  "license": "MIT",
  "type": "module",
  "main": "./dist/contentarea.cjs",
  "exports": {
    "./edit.js": {
      "types": "./dist/edit.d.ts",
      "import": "./dist/edit.js",
      "require": "./dist/edit.cjs"
    },
    "./contentarea.js": {
      "types": "./dist/contentarea.d.ts",
      "import": "./dist/contentarea.js",
      "require": "./dist/contentarea.cjs"
    },
    "./keyer.js": {
      "types": "./dist/keyer.d.ts",
      "import": "./dist/keyer.js",
      "require": "./dist/keyer.cjs"
    },
    "./history.js": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js",
      "require": "./dist/history.cjs"
    },
    "./state.js": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js",
      "require": "./dist/state.cjs"
    },
    ".": {
      "types": "./dist/contentarea.d.ts",
      "import": "./dist/contentarea.js",
      "require": "./dist/contentarea.cjs"
    },
    "./contentarea": {
      "types": "./dist/contentarea.d.ts",
      "import": "./dist/contentarea.js",
      "require": "./dist/contentarea.cjs"
    },
    "./edit": {
      "types": "./dist/edit.d.ts",
      "import": "./dist/edit.js",
      "require": "./dist/edit.cjs"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js",
      "require": "./dist/history.cjs"
    },
    "./keyer": {
      "types": "./dist/keyer.d.ts",
      "import": "./dist/keyer.js",
      "require": "./dist/keyer.cjs"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js",
      "require": "./dist/state.cjs"
    },
    "./package.json": "./dist/package.json"
  },
  "scripts": {
    "build": "libuild build",
    "publish": "libuild publish",
    "test": "playwright-test \"test/**/*.ts\" --runner uvu",
    "test:e2e": "NODE_PATH=website/node_modules bun build e2e/fixtures/todo.tsx e2e/fixtures/blockquote.tsx e2e/fixtures/rerender.tsx --outdir e2e/fixtures/dist --bundle --target browser && playwright test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "echo 'ERROR: Cannot publish from root directory. Use libuild publish instead.' && exit 1"
  },
  "devDependencies": {
    "@b9g/libuild": "^0.2.25",
    "@playwright/test": "^1.58.2",
    "fast-check": "^4.5.3",
    "playwright-test": "^8.1.1",
    "typescript": "^5.0.0",
    "uvu": "^0.5.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/contentarea.js",
  "types": "./dist/contentarea.d.ts"
}
